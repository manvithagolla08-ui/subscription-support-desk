							]
						}
					}
				},
				{
					"name": "TC-02: Cross-Tenant Violation - Alice submits Org B ID (Nexus)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 403 Forbidden\", function () {",
									"    pm.response.to.have.status(403);",
									"});",
									"pm.test(\"Blocked with message: You are not a customer of this organization\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(false);",
									"    pm.expect(jsonData.message).to.eql(\"You are not a customer of this organization\");",
									"});"
