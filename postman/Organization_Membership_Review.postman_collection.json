		{
			"name": "2. Cross-Tenant Access & Isolation Tests",
			"item": [
				{
					"name": "TC-01: Valid Ticket Creation (Alice in Apex Org)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test(\"Ticket created successfully\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    pm.expect(jsonData.data.organizationId).to.eql(pm.collectionVariables.get(\"apexOrgId\"));",
									"    pm.collectionVariables.set(\"aliceTicketId\", jsonData.data._id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"organizationId\": \"{{apexOrgId}}\",\n    \"title\": \"Apex database failover alert\",\n    \"description\": \"Primary node replication lag exceeded threshold\",\n    \"priority\": \"HIGH\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/tickets",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
